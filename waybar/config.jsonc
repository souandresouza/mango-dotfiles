// Barra unica para todas as saidas (waybar cria uma barra por monitor).
// Antes havia config.jsonc + config-laptop.jsonc so para esconder o
// 'custom/recordertime' no monitor externo. Com a barra minima as duas
// configs ficaram iguais, entao a segunda instancia foi removida
// (custava ~10 MB de overhead por processo).
// Recarregar: killall -SIGUSR2 waybar
{
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 26,
    "mode": "dock",
    "exclusive": true,
    "spacing": 0,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "ext/workspaces": {
        "format": "{name}",
        "hide-empty": true,
        "on-click": "activate",
        "on-click-right": "toggle",
        "overview-label": "OVERVIEW"
    },
    "clock": {
        "format": "{:L%A, %d/%m/%Y - %T}",
        "format-alt": "{:%A, %d/%m/%Y - %H:%M:%S}",
        "timezone": "America/Sao_Paulo",
        "locale": "pt_BR.UTF-8",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": [
            " ",
            " ",
            " "
        ],
        "scroll-step": 0.2,
        "max-volume": 100,
        "on-click": "pavucontrol"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ],
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "include": [
        "$HOME/.config/waybar/module/workspace_module"
    ],
    "modules-left": [
        "group/hworkspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "battery"
    ]
}
