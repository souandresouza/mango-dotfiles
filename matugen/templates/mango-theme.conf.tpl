split_color=0x{{colors.primary.default.hex_stripped}}ff
focus_color=0x{{colors.tertiary.default.hex_stripped}}ff
maximized_screen_color=0x{{colors.primary.default.hex_stripped}}ff
urgent_color=0x{{colors.error.default.hex_stripped}}ff
scratchpad_color=0x{{colors.tertiary.default.hex_stripped}}ff
global_color=0x{{colors.tertiary.default.hex_stripped}}ff
overlay_color=0x{{colors.primary.default.hex_stripped}}ff