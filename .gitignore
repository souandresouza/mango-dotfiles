# cmus runtime data
cmus/cache
cmus/command-history
cmus/search-history
cmus/autosave

# Editor files
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/

# Local configs that shouldn't be shared
mango/env.local
opencode/service.json
cmus/lib.pl

# Python: o código vai versionado (scripts/loop_detect.py), o ambiente não.
# O venv fica em ~/.local/share/loopdetect/venv, de propósito fora do repo -
# é o install.sh (setup_loopdetect) que o cria. O detector NUNCA deve ser
# deixado só na home: se o venv sumir sem o .py, não há de onde recuperar.
__pycache__/
*.pyc

# Backups e temporários de config
*.bak
*.bak.*
mango/.bak*

# mako removido do setup (SwayNC é o daemon de notificações)
mako/

# Runtime gerado (scripts/colors + cadrocspace recriam no boot)
cava/config_waybar
cava/cache/
swaync/colors-swaync.css
waybar/colors-waybar.css
fuzzel/colors-fuzzel.ini
cava/themes/colors
# Tema do qBittorrent: só o .tpl é versionado, o resto sai do pywal
# (~/.local/bin/qbittorrent-colors.sh é a fonte real agora)
qbittorrent/config.json
qbittorrent/stylesheet.qss
