sort=-time
layer=top
anchor=top-right
width=300
margin=12
height=250
border-size=4
border-radius=8
padding=20
icons=1
icon-location=left
markup=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=JetBrainsMono Nerd Font 10
text-alignment=center
max-visible=5

[mode=do-not-disturb]
invisible=1

[urgency=normal]
background-color=#080B0D
text-color=#bddcb0
border-color=#2D6B48

[urgency=high]
background-color=#080B0D
text-color=#bddcb0
border-color=#58A15F

[urgency=critical]
background-color=#080B0D
text-color=#bddcb0
border-color=#2D6B48
